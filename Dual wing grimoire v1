<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dual Wing Rental Marketing Engine — Grimoire v1.0</title>
<meta name="description" content="Full system documentation for a dual-sided rental marketing engine. Landlord acquisition + renter demand, connected into one flywheel. GHL · n8n · Claude API · Make.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;1,9..144,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F5F2EC;
    --bg2: #EDE9E0;
    --bg3: #E5E0D5;
    --ink: #1C1917;
    --ink2: #44403C;
    --ink3: #78716C;
    --ink4: #A8A29E;
    --accent: #C2410C;
    --accent2: #EA580C;
    --teal: #0D9488;
    --teal-bg: #CCFBF1;
    --amber: #B45309;
    --amber-bg: #FEF3C7;
    --blue: #1D4ED8;
    --blue-bg: #DBEAFE;
    --red: #B91C1C;
    --red-bg: #FEE2E2;
    --border: rgba(28,25,23,0.12);
    --border2: rgba(28,25,23,0.06);
    --code-bg: #1C1917;
    --code-fg: #D6D3D1;
    --code-comment: #78716C;
    --code-key: #FDA4AF;
    --code-val: #86EFAC;
    --code-str: #FCD34D;
    --mono: 'DM Mono', monospace;
    --serif: 'Fraunces', serif;
    --sans: 'DM Sans', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.7;
    font-weight: 300;
  }

  /* ── HEADER ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(245,242,236,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }
  .header-left { display: flex; align-items: center; gap: 1rem; }
  .header-logo {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink3);
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  .header-logo:hover { color: var(--accent); }
  .header-divider { width: 1px; height: 16px; background: var(--border); }
  .header-title {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink2);
    letter-spacing: 0.03em;
  }
  .header-badge {
    font-family: var(--mono);
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 20px;
    background: var(--amber-bg);
    color: var(--amber);
    border: 1px solid rgba(180,83,9,0.2);
  }

  /* ── NAV SIDEBAR ── */
  .layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: calc(100vh - 52px);
    max-width: 1200px;
    margin: 0 auto;
  }

  .sidebar {
    position: sticky;
    top: 52px;
    height: calc(100vh - 52px);
    overflow-y: auto;
    border-right: 1px solid var(--border);
    padding: 1.5rem 0;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .nav-section {
    margin-bottom: 1.5rem;
    padding: 0 1rem;
  }
  .nav-section-label {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink4);
    margin-bottom: 6px;
    padding: 0 8px;
  }
  .nav-link {
    display: block;
    padding: 5px 8px;
    font-size: 12px;
    color: var(--ink3);
    text-decoration: none;
    border-radius: 4px;
    line-height: 1.4;
    transition: all 0.15s;
  }
  .nav-link:hover { background: var(--bg2); color: var(--ink); }
  .nav-link.active { background: var(--bg3); color: var(--accent); font-weight: 500; }
  .nav-link.sub { padding-left: 18px; font-size: 11px; }

  /* ── MAIN CONTENT ── */
  .main {
    padding: 3rem 3rem 6rem;
    max-width: 860px;
  }

  /* ── HERO ── */
  .hero {
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }
  .hero-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .hero h1 em {
    font-style: italic;
    font-weight: 300;
    color: var(--ink2);
  }
  .hero-sub {
    font-size: 16px;
    color: var(--ink2);
    max-width: 580px;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .stat-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 2rem;
  }
  .stat-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 40px;
    border: 1px solid var(--border);
    background: var(--bg2);
    font-size: 12px;
    color: var(--ink2);
  }
  .stat-pill strong { font-weight: 500; color: var(--ink); }

  .flywheel-diagram {
    background: var(--code-bg);
    border-radius: 10px;
    padding: 1.5rem 2rem;
    margin-top: 2rem;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--code-fg);
    line-height: 1.8;
    overflow-x: auto;
  }
  .flywheel-diagram .fw-label { color: var(--ink4); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .flywheel-diagram .fw-arrow { color: var(--accent2); }
  .flywheel-diagram .fw-node { color: var(--code-val); font-weight: 500; }
  .flywheel-diagram .fw-note { color: var(--code-str); }
  .flywheel-diagram .fw-tag { color: var(--code-key); }

  /* ── WING OVERVIEW ── */
  .wing-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0;
  }
  .wing-card {
    border-radius: 10px;
    padding: 1.5rem;
    border: 1px solid var(--border);
  }
  .wing-card.landlord { background: #FFF7ED; border-color: rgba(194,65,12,0.2); }
  .wing-card.renter { background: #F0FDFA; border-color: rgba(13,148,136,0.2); }
  .wing-label {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .wing-card.landlord .wing-label { color: var(--accent); }
  .wing-card.renter .wing-label { color: var(--teal); }
  .wing-card h3 { font-size: 14px; font-weight: 500; margin-bottom: 8px; }
  .wing-card p { font-size: 12px; color: var(--ink3); line-height: 1.55; margin-bottom: 10px; }
  .wing-kpi { font-family: var(--mono); font-size: 11px; color: var(--ink3); }
  .wing-kpi span { font-weight: 500; }
  .wing-card.landlord .wing-kpi span { color: var(--accent); }
  .wing-card.renter .wing-kpi span { color: var(--teal); }

  /* ── MODULE SECTIONS ── */
  .module-section {
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border2);
  }
  .module-section:last-of-type { border-bottom: none; }

  .module-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .module-number {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink4);
    padding: 4px 8px;
    border: 1px solid var(--border);
    border-radius: 4px;
    white-space: nowrap;
    margin-top: 4px;
  }
  .module-title-group {}
  .module-title {
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.2;
    margin-bottom: 4px;
  }
  .module-sub { font-size: 13px; color: var(--ink3); }

  h2.section-heading {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 2rem 0 1rem;
  }
  h3.sub-heading {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--mono);
    margin: 1.5rem 0 0.75rem;
  }

  p { margin-bottom: 0.75rem; color: var(--ink2); font-size: 14px; }

  /* ── CODE BLOCKS ── */
  pre {
    background: var(--code-bg);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1rem 0;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.75;
    color: var(--code-fg);
  }
  pre .c { color: var(--code-comment); font-style: italic; }
  pre .k { color: var(--code-key); }
  pre .v { color: var(--code-val); }
  pre .s { color: var(--code-str); }
  pre .h { color: var(--ink3); }
  pre .w { color: #F8FAFC; font-weight: 500; }

  /* ── TABLES ── */
  .table-wrap { overflow-x: auto; margin: 1rem 0; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }
  th {
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink3);
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg2);
  }
  td {
    padding: 9px 12px;
    border-bottom: 1px solid var(--border2);
    color: var(--ink2);
    vertical-align: top;
    line-height: 1.5;
  }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: var(--bg2); }

  /* ── CALLOUT BOXES ── */
  .callout {
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1rem 0;
    font-size: 13px;
    line-height: 1.6;
  }
  .callout-warn {
    background: var(--amber-bg);
    border-left: 3px solid var(--amber);
    color: #78350F;
  }
  .callout-danger {
    background: var(--red-bg);
    border-left: 3px solid var(--red);
    color: #7F1D1D;
  }
  .callout-info {
    background: var(--blue-bg);
    border-left: 3px solid var(--blue);
    color: #1E3A8A;
  }
  .callout-success {
    background: var(--teal-bg);
    border-left: 3px solid var(--teal);
    color: #134E4A;
  }
  .callout strong { font-weight: 500; }

  /* ── SCORE BUCKETS ── */
  .score-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin: 1rem 0; }
  .score-card {
    border-radius: 8px;
    padding: 1rem;
    text-align: center;
    border: 1px solid var(--border);
  }
  .score-card.hot { background: #FFF1F2; border-color: rgba(185,28,28,0.2); }
  .score-card.warm { background: #FFF7ED; border-color: rgba(180,83,9,0.2); }
  .score-card.cold { background: var(--blue-bg); border-color: rgba(29,78,216,0.2); }
  .score-card .score-range { font-family: var(--mono); font-size: 18px; font-weight: 500; }
  .score-card.hot .score-range { color: var(--red); }
  .score-card.warm .score-range { color: var(--amber); }
  .score-card.cold .score-range { color: var(--blue); }
  .score-card .score-label { font-size: 11px; color: var(--ink3); margin-top: 4px; }
  .score-card .score-action { font-size: 11px; margin-top: 8px; color: var(--ink2); }

  /* ── SEQUENCE TIMELINE ── */
  .sequence-timeline { margin: 1.5rem 0; }
  .seq-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    position: relative;
  }
  .seq-item::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 36px;
    bottom: -8px;
    width: 1px;
    background: var(--border);
  }
  .seq-item:last-child::before { display: none; }
  .seq-day {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--ink3);
    font-weight: 500;
  }
  .seq-content { flex: 1; padding-bottom: 0.5rem; }
  .seq-trigger { font-size: 12px; font-weight: 500; color: var(--ink); margin-bottom: 4px; }
  .seq-actions { font-size: 12px; color: var(--ink3); line-height: 1.55; }
  .seq-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 3px;
    background: var(--bg3);
    color: var(--ink3);
    margin: 2px 2px 0 0;
  }

  /* ── STACK TABLE BADGES ── */
  .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 3px;
    vertical-align: middle;
  }
  .badge-essential { background: var(--teal-bg); color: #134E4A; }
  .badge-defer { background: var(--bg3); color: var(--ink3); }
  .badge-optional { background: var(--amber-bg); color: #78350F; }

  /* ── CRITICAL FAILURES ── */
  .failure-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin: 1rem 0;
  }
  .failure-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 8px 10px;
    background: var(--red-bg);
    border-radius: 6px;
    font-size: 12px;
    color: #7F1D1D;
    line-height: 1.45;
  }
  .failure-icon { flex-shrink: 0; margin-top: 1px; font-size: 13px; }

  /* ── EXECUTION TIMELINE ── */
  .exec-weeks { margin: 1.5rem 0; }
  .exec-week {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .week-badge {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 8px;
    background: var(--bg3);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 9px;
    color: var(--ink4);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    gap: 2px;
  }
  .week-badge strong { font-size: 16px; color: var(--ink2); line-height: 1; }
  .week-body { flex: 1; }
  .week-title { font-size: 13px; font-weight: 500; color: var(--ink); margin-bottom: 6px; }
  .week-items { font-size: 12px; color: var(--ink3); line-height: 1.7; }
  .check-item::before { content: '☐ '; color: var(--accent); }

  /* ── COMPLIANCE TABLE ── */
  .compliance-region { margin-bottom: 2rem; }
  .region-label {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  /* ── FOOTER ── */
  .page-footer {
    margin-top: 4rem;
    padding: 2rem 3rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink4);
  }
  .footer-link {
    color: var(--accent);
    text-decoration: none;
  }
  .footer-link:hover { text-decoration: underline; }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { display: none; }
    .main { padding: 2rem 1.25rem 4rem; }
    .wing-cards { grid-template-columns: 1fr; }
    .score-row { grid-template-columns: 1fr; }
    .failure-grid { grid-template-columns: 1fr; }
    .hero h1 { font-size: 1.8rem; }
  }
</style>
</head>
